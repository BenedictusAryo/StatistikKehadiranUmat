    {
      "id": "claim_7eb866700e0c406cb8d3eb1a32d0d84a",
      "statement": "The SQLAlchemy engine in app/database.py adapts to the environment: check_same_thread=False is applied only for SQLite connections, pool_pre_ping=True is always set, and the engine is built from settings.DATABASE_URL read at import time.",

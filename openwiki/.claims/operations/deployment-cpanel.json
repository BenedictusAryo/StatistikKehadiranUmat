    {
      "id": "claim_88e5ea410e9042f78aedcb99a337a2d0",
      "statement": "Application configuration is a pydantic-settings BaseSettings subclass (app/config.py) whose DATABASE_URL defaults to SQLite for development and is overridden to mysql+pymysql for cPanel production; the .env file is loaded automatically via env_file='.env' with extra fields allowed.",
      "evidence": [
        {
          "resource": "repo://app/config.py#L5-L22",
          "version": "repo-lines-v1:sha256:662049a651d3179a17cff657922800d6e8fb4365e9e9dc17c2b1eff5e20e18a6:"

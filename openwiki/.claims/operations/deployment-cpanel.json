    {
      "id": "claim_e91477ebde1743b8961b7fad4fd0f080",
      "statement": "passenger_wsgi.py is the WSGI entrypoint for cPanel Phusion Passenger: it inserts the project root into sys.path, imports the FastAPI app from app.main, and exposes it as the `application` callable wrapped in a2wsgi.ASGIMiddleware so the ASGI app can serve WSGI requests.",
      "evidence": [
        {
          "resource": "repo://passenger_wsgi.py#L1-L11",
          "version": "repo-lines-v1:sha256:e02eda9b1f1d750c8283564edafc8a30bdd3abf0f38969dd92531ddec05abd12:"
        }
      ]
    },
    {
      "id": "claim_53fd2f8b42ba4373bf54531cadb9a449",
      "statement": "The a2wsgi and pymysql packages in requirements.txt are the two dependencies that make cPanel production possible: a2wsgi bridges WSGI to ASGI for Passenger, and pymysql is the pure-Python MySQL driver named in the production DATABASE_URL.",
      "evidence": [
        {
          "resource": "repo://requirements.txt#L11-L12",
          "version": "repo-lines-v1:sha256:67d13e825ddb6a08ad89dd898786dd5e7464ad52d5bcf47faf88aa9ec07d3ac8:"
        }
      ]

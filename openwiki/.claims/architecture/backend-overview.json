    {
      "id": "claim_c7f74fe2b65346ba877bb695149ebfd3",
      "statement": "The live stats endpoint `GET /api/stats/{event_id}/live` uses a cache-first pattern: it returns a cached `LiveStatsResponse` if available within TTL, otherwise computes totals, per-pos breakdowns, per-building rollups, 15-minute time-series buckets, and capacity status from the database, then caches the result.",
      "evidence": [
        {
          "resource": "repo://app/routers/stats.py#L19-L144",
          "version": "repo-lines-v1:sha256:ca72eb2849aef44b7aa36e844dd8a8d63fce3ee29b5a1b67653be5264544c4a3:"
        }

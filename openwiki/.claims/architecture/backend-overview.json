    {
      "id": "claim_fc4c55d99ffc41b1a7f85e1a6a4b30a5",
      "statement": "The counter endpoint `POST /api/counter/{token}/sync` provides offline-first batch sync with idempotency: incoming tap UUIDs are checked against existing `AttendanceLog.id` values before insertion, and duplicates are silently skipped.",

      "id": "claim_53a600d061a84b82b7a5299879588555",
      "statement": "The FastAPI application is constructed at module level in /app/main.py so that ASGI servers (uvicorn, Passenger via a2wsgi) can import it directly as `app`.",
      "evidence": [
        {
          "resource": "repo://app/main.py#L1-L83",
